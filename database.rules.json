{
  "rules": {
    "superadmins": {
      ".read": "auth != null && root.child('superadmins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "bakeries": {
      ".read": "auth != null && root.child('superadmins').child(auth.uid).exists()",

      "$bid": {
        ".read": true,

        ".write": "auth != null && ((!data.exists() && newData.child('info').child('ownerUid').val() === auth.uid) || root.child('superadmins').child(auth.uid).exists())",

        "info": {
          ".write": "auth != null && ((newData.child('ownerUid').val() === auth.uid && (!data.exists() || data.child('ownerUid').val() === auth.uid)) || root.child('superadmins').child(auth.uid).exists())",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "ownerUid": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "menuUrl": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "logoUrl": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "$other": { ".validate": false }
        },

        "state": {
          "currentlyServing": {
            ".write": "auth != null && (root.child('bakeries').child($bid).child('info').child('ownerUid').val() === auth.uid || root.child('superadmins').child(auth.uid).exists())",
            ".validate": "newData.isNumber() || newData.val() === null"
          },
          "nextTicketNumber": {
            ".write": "auth != null && (root.child('bakeries').child($bid).child('info').child('ownerUid').val() === auth.uid || root.child('superadmins').child(auth.uid).exists() || (data.exists() && newData.val() === data.val() + 1))",
            ".validate": "newData.isNumber() && newData.val() >= 1"
          }
        },

        "waiting": {
          ".write": "auth != null",
          "$ticket": {
            "number": { ".validate": "newData.isNumber()" },
            "joinedAt": { ".validate": "newData.isNumber()" }
          }
        }
      }
    },

    "users": {
      ".read": "auth != null && root.child('superadmins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('superadmins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('superadmins').child(auth.uid).exists())"
      }
    }
  }
}
